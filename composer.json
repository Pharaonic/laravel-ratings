{
  "name": "pharaonic/laravel-ratings",
  "description": "Polymorphic ratings for Laravel Eloquent models: one rating per rater and target, configurable scales, optional comments, and database-enforced uniqueness.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "ratings",
    "rating",
    "reviews",
    "stars",
    "eloquent",
    "polymorphic",
    "pharaonic"
  ],
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/ratings",
    "issues": "https://github.com/Pharaonic/laravel-ratings/issues",
    "source": "https://github.com/Pharaonic/laravel-ratings"
  },
  "require": {
    "php": ">=8.2 <8.5",
    "illuminate/contracts": "^11.0",
    "illuminate/database": "^11.0",
    "illuminate/support": "^11.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^9.0",
    "pestphp/pest": "^3.8",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5.50"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\Ratings\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\Ratings\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\Ratings\\RatingsServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": {
          "laravel/framework": "No fixed release within Laravel 11; the application chooses the framework release."
        }
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
